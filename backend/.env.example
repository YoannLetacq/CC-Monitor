# CC-monitor backend environment variables
# Copy this file to .env and adjust values for your environment.
# Do NOT commit .env — it may contain sensitive information.

# Port on which the backend API listens
API_PORT=8787

# Allowed CORS origins — comma-separated list of frontend origins.
# A JSON array (["url1","url2"]) is also accepted.
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Absolute or ~ path to the Claude projects root directory
CLAUDE_PROJECTS_ROOT=~/.claude/projects
