# CC-monitor — environment variables example
# Copy this file to .env and fill in the values for your environment.
# Never commit .env (it is listed in .gitignore).

# Port the backend API listens on (default: 8787)
API_PORT=8787

# Allowed CORS origins for the frontend dev server (comma-separated)
# Add multiple origins separated by commas; no spaces around commas required.
# Example: http://localhost:5173,http://localhost:4173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Absolute path to the Claude projects root directory
# This is the directory Claude Code uses to store project state.
# Example: /home/youruser/.claude/projects
CLAUDE_PROJECTS_ROOT=
